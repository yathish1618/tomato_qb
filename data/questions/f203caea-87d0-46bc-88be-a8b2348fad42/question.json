  "type": "MCQ",
  "question": "Let $0\\le\\theta,\\phi<2\\pi$ be two angles. Then, the equation $\\sin\\theta+\\sin\\phi=\\cos\\theta+\\cos\\phi$",
  "options": {
    "A": "determines $\\theta$ uniquely in terms of $\\phi$;",
    "B": "gives two values of $\\theta$ for each value of $\\phi$;",
    "C": "gives more than two values of $\\theta$ for each value of $\\phi$;",
    "D": "none of the above."
  },
  "answer": "B",
