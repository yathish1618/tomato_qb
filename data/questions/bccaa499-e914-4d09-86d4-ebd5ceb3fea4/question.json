  "type": "MCQ",
  "question": "If $f(x)$ is a polynomial in $x$ and $a,b$ are distinct real numbers, then the remainder in the division of $f(x)$ by $(x-a)(x-b)$ is",
  "options": {
    "A": "$\\frac{(x-a)f(a)-(x-b)f(b)}{a-b}$",
    "B": "$\\frac{(x-a)f(b)-(x-b)f(a)}{b-a}$",
    "C": "$\\frac{(x-a)f(b)-(x-b)f(a)}{a-b}$",
    "D": "$\\frac{(x-a)f(a)-(x-b)f(b)}{b-a}$"
  },
  "answer": "B",
