  "question": "What is the maximum possible value of a positive integer $n$, such that for any choice of seven distinct elements from $\\{1,2,\\ldots,n\\}$, there will exist two numbers $x$ and $y$ satisfying $1<x/y\\le2$?",
  "options": {
    "A": "$2\\times7$",
    "B": "$2^7-2$",
    "C": "$7^2-2$",
    "D": "$7^7-2$"
  },
  "answer": "B",
