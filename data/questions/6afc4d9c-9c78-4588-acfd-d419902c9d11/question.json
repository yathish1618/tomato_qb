  "question": "Let \\([x]\\) denote the greatest integer less than or equal to \\(x\\). The value of the integral\n\\[\n\\int_1^n [x]^{x-[x]}\\,dx\n\\]\nis equal to",
  "options": {
    "A": "\\(1+\\frac{2^3}{\\log_e2}-\\frac{2^2}{\\log_e2}+\\frac{3^4}{\\log_e3}-\\frac{3^3}{\\log_e3}+\\cdots+\\frac{(n-1)^n}{\\log_e(n-1)}-\\frac{(n-1)^{n-1}}{\\log_e(n-1)}\\)",
    "B": "\\(1+\\frac{1}{\\log_e2^2}+\\frac{2}{\\log_e3^3}+\\cdots+\\frac{n-2}{\\log_e(n-1)}\\)",
    "C": "\\(\\frac12+\\frac{2^2}{3}+\\cdots+\\frac{n^{n+1}}{n+1}\\)",
    "D": "\\(\\frac{2^3-1}{3}+\\frac{3^4-2^3}{4}+\\cdots+\\frac{n^{n+1}-(n-1)^n}{n+1}\\)"
  },
  "answer": "B",
