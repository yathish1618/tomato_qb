    "A": "\\([-k,k]\\)",
    "B": "\\([-\\frac{k}{2},\\frac{k}{2}]\\)",
    "C": "\\([-\\frac{k}{2},k]\\)",
    "D": "\\([-k,\\frac{k}{2}]\\)"
  },
  "answer": "C",
