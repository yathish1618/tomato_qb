  "type": "MCQ",
  "question": "The $m^{th}$ term of an arithmetic progression is $x$ and the $n^{th}$ term is $y$. Then the sum of the first $(m+n)$ terms is",
  "options": {
    "A": "$\\frac{m+n}{2}\\left[(x+y)+\\frac{x-y}{m-n}\\right]$",
    "B": "$\\frac{m+n}{2}\\left[(x-y)+\\frac{x+y}{m-n}\\right]$",
    "C": "$\\frac12\\left[\\frac{x+y}{m+n}+\\frac{x-y}{m-n}\\right]$",
    "D": "$\\frac12\\left[\\frac{x+y}{m+n}-\\frac{x-y}{m-n}\\right]$"
  },
  "answer": "A",
