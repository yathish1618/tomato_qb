  "type": "MCQ",
  "question": "Suppose $ABCD$ is a quadrilateral such that the coordinates of $A$, $B$ and $C$ are $(1,3)$, $(-2,6)$ and $(5,-8)$ respectively. For which choices of coordinates of $D$ will $ABCD$ be a trapezium?",
  "options": {
    "A": "$(3,-6)$",
    "B": "$(6,-9)$",
    "C": "$(0,5)$",
    "D": "$(3,-1)$"
  },
  "answer": "B,D",
