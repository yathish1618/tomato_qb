    "A": "\\(I_1>I_2>I_3\\)",
    "B": "\\(I_2>I_1>I_3\\)",
    "C": "\\(I_3>I_1>I_2\\)",
    "D": "\\(I_1>I_3>I_2\\)"
  },
  "answer": "D",
